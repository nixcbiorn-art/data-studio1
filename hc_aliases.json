if __name__ == "__main__":
    print("=" * 64)
    print("  fix_all.py — ремонт после патчей 1–12")
    print("=" * 64)

    fix_threading()
    fix_preflight()
    fix_env()

    code = verify()

    print("\n" + "=" * 64)
    print("  ИТОГ")
    print("=" * 64)
    for line in report:
        print(f"  {line}")

    if code == 0:
        print("\n  ✅ Проект готов к запуску:")
        print("     python redcat_scraper.py --only apartments")
    else:
        print("\n  ⚠️  Есть проблемы — см. выше")

    print("=" * 64)
    sys.exit(code)