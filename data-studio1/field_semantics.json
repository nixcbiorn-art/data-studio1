  "_derived_rules": [
    {
      "name": "price_per_sqm",
      "needs": ["price", "area"],
      "formula": "{price} / {area}"
    },
    {
      "name": "price_per_room",
      "needs": ["price", "rooms"],
      "formula": "{price} / {rooms}"
    },
    {
      "name": "price_with_discount",
      "needs": ["price", "percent"],
      "formula": "{price} * (1 - {percent} / 100)"
    },
    {
      "name": "floor_ratio",
      "needs": ["floor", "floors_total"],
      "formula": "{floor} / {floors_total}"
    }
  ],

  "_checks_rules": [
    {"field": "price",         "test": "positive",  "advice": "Цена должна быть больше нуля"},
