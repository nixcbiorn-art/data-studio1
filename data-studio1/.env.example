# Скопируйте этот файл в ".env" (без .example) и впишите реальные значения.
# Файл .env не должен попадать в git / никому не пересылаться — он содержит секрет.

REDCAT_TOKEN=вставьте_сюда_ваш_реальный_токен

# Необязательно — можно поменять регион/страну без правки кода:
# REDCAT_REGION_ID=20003956
# REDCAT_COUNTRY_ID=2017370
