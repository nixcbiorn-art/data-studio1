+/* ---------- box-plot (сводка по группам) ---------- */
+.box-row { display: grid; grid-template-columns: minmax(120px, 230px) 1fr auto; gap: 10px; align-items: center; margin-bottom: 7px; font-size: 12.5px; }
+.box-track { position: relative; height: 22px; background: var(--bg); border-radius: 4px; }
+.box-whisker { position: absolute; top: 50%; height: 1px; background: var(--muted); transform: translateY(-50%); }
+.box-whisker::before, .box-whisker::after {
+  content: ""; position: absolute; top: 50%; width: 1px; height: 9px;
+  background: var(--muted); transform: translateY(-50%);
+}
+.box-whisker::before { left: 0; } .box-whisker::after { right: 0; }
+.box-body { position: absolute; top: 3px; bottom: 3px; background: rgba(79,140,255,.32);
+  border: 1px solid var(--accent); border-radius: 3px; }
+.box-median { position: absolute; top: 1px; bottom: 1px; width: 2px; background: #fff; }
+.box-val { font-family: var(--mono); font-size: 12px; text-align: right; min-width: 92px; }
+.box-legend { display: flex; gap: 16px; flex-wrap: wrap; font-size: 11px; color: var(--muted); margin: 2px 0 12px; }
