  "_derived_rules": [
    {
      "name": "price_per_sqm",
      "needs": [
        "price",
        "area"
      ],
      "formula": "{price} / {area}"
    },
    {
      "name": "price_per_room",
      "needs": [
        "price",
        "rooms"
      ],
      "formula": "{price} / {rooms}"
    },
    {
      "name": "price_with_discount",
      "needs": [
        "price",
        "percent"
      ],
      "formula": "{price} * (1 - {percent} / 100)"
    },
    {
      "name": "floor_ratio",
      "needs": [
        "floor",
        "floors_total"
      ],
      "formula": "{floor} / {floors_total}"
    }
  ],
  "_checks_rules": [
    {
      "field": "price",
      "test": "positive",
      "advice": "Цена должна быть больше нуля"
    },
    {
      "field": "area",
      "test": "range",
      "min": 5,
      "max": 500,
      "advice": "Площадь квартиры в м² — разумный диапазон 5–500"
    },
    {
      "field": "floor",
      "test": "positive",
      "advice": "Этаж должен быть больше нуля"
    },
    {
      "field": "floors_total",
      "test": "positive",
      "advice": "Этажей в доме должно быть больше нуля"
    },
    {
      "field": "floor",
      "test": "lte_field",
      "ref": "floors_total",
      "advice": "Этаж не может быть больше этажей в доме"
    },
    {
      "field": "percent",
      "test": "range",
      "min": 0,
      "max": 100,
      "advice": "Проценты в диапазоне 0–100"
    },
    {
      "field": "rooms",
      "test": "range",
      "min": 0,
      "max": 20,
      "advice": "Комнат обычно 0–20"
    }
  ]
}
